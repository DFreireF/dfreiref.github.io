&lt;tr&gt;
&lt;td&gt;2023-03-01&lt;/td&gt;
&lt;td&gt;Chemex&lt;/td&gt;
&lt;td&gt;Medium-coarse&lt;/td&gt;
&lt;td&gt;Any&lt;/td&gt;
&lt;td&gt;95°C&lt;/td&gt;
&lt;td&gt;4:10&lt;/td&gt;
